# Copy to .env.local and adjust. Values here are the defaults in
# src/config/env.ts, so the app runs without this file.

# Canonical site origin. Used for `metadataBase`, absolute OG/Twitter image
# URLs, and the domain printed on the generated share card.
#
# NOTE: this is inlined at BUILD time, and app/opengraph-image.tsx is
# prerendered, so the share card bakes in whatever this is set to when you run
# `next build`. Set the real domain in your deploy environment before shipping.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://pishon-nine.vercel.app (the default in src/config/env.ts)

# Base URL the API client points at.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
